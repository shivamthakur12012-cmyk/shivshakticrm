# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com,https://app.yourdomain.com

# Database (PostgreSQL / Neon / Supabase / AWS RDS)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Redis Cache & Queue
REDIS_URL="redis://default:password@redis-host:6379"

# Authentication Secrets
JWT_SECRET=generate_a_secure_random_string_here_min_32_chars
JWT_REFRESH_SECRET=generate_another_secure_random_string_here_min_32_chars
COOKIE_SAME_SITE=lax # Use 'lax' if same-domain or proxied; 'none' if backend and frontend are on completely separate domains

# Email / SMTP (MailerCloud or standard SMTP)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=support@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=support@yourdomain.com

# Storage Provider (local or s3)
STORAGE_PROVIDER=local # or 's3'
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ap-south-1

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
